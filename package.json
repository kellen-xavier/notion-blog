{
  "name": "notion-blog",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build && node .next/server/build-rss.js",
    "format": "prettier --write \"**/*.{js,jsx,json,ts,tsx,md,mdx,css,html,yml,yaml,scss,sass}\" --ignore-path .gitignore",
    "lint-staged": "lint-staged",
    "vercel-build": "ts-node src/lib/build-rss.ts && next build"
  },
  "pre-commit": "lint-staged",
  "dependencies": {
    "@zeit/react-jsx-parser": "2.0.0",
    "async-sema": "3.1.1",
    "github-slugger": "2.0.0",
    "katex": "0.16.22",
    "next": "^15.5.3",
    "node-fetch": "^3.3.2",
    "prismjs": "1.30.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "uuid": "13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/katex": "0.16.7",
    "@types/node": "^24.3.1",
    "@types/react": "19.1.12",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@typescript-eslint/utils": "^8.43.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react": "^7.37.5",
    "lint-staged": "16.1.6",
    "pre-commit": "1.2.2",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.43.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
