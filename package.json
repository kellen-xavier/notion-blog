{
  "name": "notion-blog",
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build && node .next/server/build-rss.js",
    "format": "prettier --write \"**/*.{js,jsx,json,ts,tsx,md,mdx,css,html,yml,yaml,scss,sass}\" --ignore-path .gitignore",
    "typecheck": "tsc --noEmit",
    "test": "TS_NODE_TRANSPILE_ONLY=true TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\",\"jsx\":\"react\"}' node --require ts-node/register --test test/*.test.ts",
    "lint-staged": "lint-staged",
    "vercel-build": "ts-node src/lib/build-rss.ts && next build"
  },
  "pre-commit": "lint-staged",
  "dependencies": {
    "@next/env": "11.1.2",
    "@zeit/react-jsx-parser": "2.0.0",
    "async-sema": "3.1.0",
    "github-slugger": "1.2.1",
    "katex": "0.12.0",
    "next": "^11.1.2",
    "node-fetch": "2.6.1",
    "prismjs": "1.17.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "uuid": "8.1.0"
  },
  "devDependencies": {
    "@types/katex": "0.11.0",
    "@types/node": "^22.15.26",
    "@types/node-fetch": "2.6.1",
    "@types/react": "17.0.2",
    "lint-staged": "10.5.4",
    "pre-commit": "1.2.2",
    "prettier": "2.2.1",
    "shell-quote": "1.7.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
