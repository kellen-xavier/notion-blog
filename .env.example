# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA edite/commite o .env.local — ele já está no .gitignore.

# Token de sessão da sua conta Notion (cookie "token_v2").
# Como obter: faça login em notion.so pelo navegador, abra o DevTools >
# Application/Storage > Cookies > notion.so > copie o valor de "token_v2".
#
# ⚠️ NÃO é a chave de integração da API pública do Notion (a que começa
# com "ntn_" ou "secret_", gerada em notion.so/my-integrations). Este
# projeto usa a API privada (api/v3) do notion.so, autenticada só pelo
# cookie de sessão do navegador — um valor de integração não funciona
# aqui e falha de um jeito enganoso (sem erro de autenticação, só sem
# encontrar a tabela de posts).
NOTION_TOKEN=

# ID da página do Notion que contém a tabela de posts (a página onde você
# rodou `node scripts/create-table.js`). Pode ser copiado da URL da página
# no Notion (com ou sem hífens, o app normaliza).
BLOG_INDEX_ID=

# Segredo próprio, usado só para liberar o modo preview (/api/preview).
# Gere um valor aleatório, por exemplo: openssl rand -hex 32
# Use um valor DIFERENTE do NOTION_TOKEN — assim, se o link de preview
# vazar, sua sessão do Notion continua segura.
PREVIEW_TOKEN=
